{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contributors": [
    "eetgeenappels",
    "BluSpring"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/millies-core-libs",
    "issues": "https://github.com/JustMili0/MilliesCoreLibraries/issues",
    "sources": "https://github.com/JustMili0/MilliesCoreLibraries"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.justmili.corelibs.CoreLibs"
    ],
    "client": [
      "net.justmili.corelibs.client.FabricClient"
    ],
    "modmenu": [
      "net.justmili.corelibs.client.ModMenuEntrypoint"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-language-kotlin": ">=${kotlin_version}",
    "minecraft": "${minecraft_version_constraint}"
  },
  "recommends": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/DPEw9DU2vT"
      },
      "badges": [
        "library"
      ]
    }
  }
}